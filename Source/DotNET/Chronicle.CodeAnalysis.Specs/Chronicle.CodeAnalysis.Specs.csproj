<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Chronicle.CodeAnalysis.Specs</AssemblyName>
        <RootNamespace>Cratis.Arc.Chronicle.CodeAnalysis</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);MA0101;RCS1266</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="../GlobalUsings.Specs.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
        <!-- The Roslyn testing XUnit verifiers need the xunit v2 assert at runtime; keep it out of compilation so it does not clash with xunit.v3.assert. -->
        <PackageReference Include="xunit.assert" ExcludeAssets="compile" />
        <PackageReference Include="Microsoft.Composition" />
        <PackageReference Include="System.Formats.Asn1" />
        <PackageReference Include="Cratis.Chronicle" />
        <ProjectReference Include="../Chronicle.CodeAnalysis/Chronicle.CodeAnalysis.csproj" />
        <ProjectReference Include="../Chronicle.CodeAnalysis.CodeFixes/Chronicle.CodeAnalysis.CodeFixes.csproj" />
        <ProjectReference Include="../Chronicle/Chronicle.csproj" />
    </ItemGroup>
    <!-- Exercise the same Chronicle analyzer NuGet supplies to consumer compilations. -->
    <Target Name="ReferenceChronicleAnalyzer" AfterTargets="ResolveLockFileAnalyzers" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <Reference Include="@(Analyzer->WithMetadataValue('Filename', 'Cratis.Chronicle.CodeAnalysis'))" />
        </ItemGroup>
    </Target>
</Project>

