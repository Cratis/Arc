<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Availability</AssemblyName>
        <RootNamespace>Cratis.Arc.Availability</RootNamespace>
        <Description>Availability gates for Cratis Arc: commands and queries of a part of the application that is not available are refused before authorization, built on the Cratis Choreography availability engine.</Description>
        <PackageTags>cratis;arc;cqrs;availability;audiences;choreography</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Arc.Availability.Specs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Arc.Core/Arc.Core.csproj" />
        <PackageReference Include="Cratis.Choreography" />
    </ItemGroup>
</Project>
