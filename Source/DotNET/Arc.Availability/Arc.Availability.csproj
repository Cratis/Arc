<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Availability</AssemblyName>
        <RootNamespace>Cratis.Arc.Availability</RootNamespace>
        <Description>Availability for Cratis Arc: commands and queries of a part of the application that is not available are refused before authorization. Includes the availability engine (expressions, audiences, context values), which does not depend on ASP.NET.</Description>
        <PackageTags>cratis;arc;cqrs;availability;audiences;engine</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Arc.Availability.Specs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Arc.Core/Arc.Core.csproj" />
    </ItemGroup>
</Project>
