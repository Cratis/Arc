<Project>
    <!-- Emits the assembly rollout declaration without changing command execution. -->
    <ItemGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(CratisReadProtection)', '^(Off|Measure|On)$'))">
        <AssemblyAttribute Include="Cratis.Arc.Commands.ReadProtectionAttribute">
            <_Parameter1>Cratis.Arc.Commands.ReadProtectionMode.$(CratisReadProtection)</_Parameter1>
            <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
        </AssemblyAttribute>
    </ItemGroup>

    <Target Name="_CratisArcValidateReadProtection"
            BeforeTargets="CoreGenerateAssemblyInfo"
            Condition="'$(CratisReadProtection)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(CratisReadProtection)', '^(Off|Measure|On)$'))">
        <Error Text="CratisReadProtection must be Off, Measure, or On." />
    </Target>

    <!-- Emits the namespace mapping the proxy generator uses for output folders (NamespaceRoot items and
         CratisProxiesSegmentsToSkip) as assembly attributes, so Arc resolves the same slice location for a command or
         query at runtime as the generator writes into its proxy. -->
    <Target Name="_CratisArcSliceLocationAttributes"
            BeforeTargets="GetAssemblyAttributes"
            Condition="'$(GenerateAssemblyInfo)' != 'false'">
        <ItemGroup>
            <AssemblyAttribute Include="Cratis.Arc.Slices.SliceNamespaceRootAttribute" Condition="'%(NamespaceRoot.Namespace)' != ''">
                <_Parameter1>%(NamespaceRoot.Namespace)</_Parameter1>
            </AssemblyAttribute>
            <AssemblyAttribute Include="Cratis.Arc.Slices.SliceNamespaceSegmentsToSkipAttribute"
                               Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(CratisProxiesSegmentsToSkip)', '^\s*\d+\s*$'))">
                <_Parameter1>$(CratisProxiesSegmentsToSkip.Trim())</_Parameter1>
                <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!-- Reports the project references of the compilation to the ProjectReferenceModulesGenerator in
         Cratis.Arc.Core, which emits code into an executable that runs the module initializers of each of them. Those
         register the metadata generated for them, and without this the runtime can only find them through the
         dependency context, which single-file and trimmed applications do not have.

         The value is the number of project references followed by their file names, separated by '|': the analyzer
         config file the property travels through treats ';' and '#' as comments, and the count lets the generator
         tell a complete list from a truncated one.

         With DisableTransitiveProjectReferences, projects referenced only transitively are still deployed but are not
         compile-time references, so the list would be incomplete. Nothing is reported then, and Arc keeps discovering
         project assemblies through the runtime dependency context. -->
    <ItemGroup>
        <CompilerVisibleProperty Include="CratisArcProjectReferences" />
    </ItemGroup>

    <Target Name="_CratisArcCollectProjectReferences"
            BeforeTargets="GenerateMSBuildEditorConfigFileCore"
            DependsOnTargets="ResolveReferences"
            Condition="'$(DisableTransitiveProjectReferences)' != 'true'">
        <ItemGroup>
            <_CratisArcProjectReference Include="@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
        </ItemGroup>
        <PropertyGroup>
            <CratisArcProjectReferences>@(_CratisArcProjectReference->Count())|@(_CratisArcProjectReference->'%(Filename)', '|')</CratisArcProjectReferences>
        </PropertyGroup>
    </Target>
</Project>
