<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>EmbeddedXunitMtpConsumer</AssemblyName>
        <RootNamespace>Company.XunitApplication</RootNamespace>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <GenerateTestingPlatformApplicationHelper>true</GenerateTestingPlatformApplicationHelper>
        <IsPackable>false</IsPackable>
        <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);SP0024</MSBuildWarningsAsErrors>
        <CratisEmbeddedScreenplayTaskAssembly>$(MSBuildThisFileDirectory)../../../Tools/Screenplay.Embedded.Build/bin/$(Configuration)/$(TargetFramework)/Cratis.Arc.Screenplay.Embedded.Build.dll</CratisEmbeddedScreenplayTaskAssembly>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <ProjectReference Include="../../../Arc.Core/Arc.Core.csproj" />
        <ProjectReference Include="../../../Tools/Screenplay.Embedded.Build/Screenplay.Embedded.Build.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../../../Screenplay.Embedded/Screenplay.Embedded.csproj" />
        <Compile Include="../XunitConsumer/ExecutableProof.cs" Link="ExecutableProof.cs" />
        <Compile Include="../XunitConsumer/SignIn.cs" Link="SignIn.cs" />
        <EmbeddedResource Include="../Consumer/Messages.resx" Link="Messages.resx" />
    </ItemGroup>
    <Import Project="../../../Screenplay.Embedded/build/Cratis.Arc.Screenplay.Embedded.targets" />
</Project>
