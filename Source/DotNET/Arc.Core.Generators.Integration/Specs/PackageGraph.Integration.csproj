<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Core.Generators.Integration.Specs</AssemblyName>
        <RootNamespace>Cratis.Arc.Core.Generators.Integration.Specs</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <NoWarn>$(NoWarn);MA0101;RCS1266;MA0136</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../Cratis/Cratis.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="../../Cratis.CodeAnalysis/Cratis.CodeAnalysis.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

    <!-- pull_request_target executes workflow structure from main, so a new matrix job cannot be made reliable from
         the branch under review. Run the package graph after its two build roots inside the existing cached build job;
         any failure fails dotnet-build. The nested test skips compilation and does not re-enter this Build target. -->
    <Target Name="RunPackageGraphSpecificationsInContinuousIntegration"
            AfterTargets="Build"
            Condition="'$(CI)' == 'true' AND '$(TargetFramework)' == 'net10.0'">
        <Exec Command="dotnet test &quot;$(MSBuildProjectFullPath)&quot; --no-build --configuration &quot;$(Configuration)&quot; --framework &quot;$(TargetFramework)&quot; --logger &quot;console;verbosity=minimal&quot;" />
    </Target>
</Project>
