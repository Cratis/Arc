<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.ProxyGenerator.Specs</AssemblyName>
        <RootNamespace>Cratis.Arc.ProxyGenerator</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Disable StyleCop rules for test helper files containing multiple types -->
        <NoWarn>$(NoWarn);SA1649;SA1402</NoWarn>
        <!-- Enable runtime-specific native libraries for ClearScript V8 -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../ProxyGenerator/ProxyGenerator.csproj" />
        <ProjectReference Include="TestArtifacts/RuntimeDependencyApplication/RuntimeDependencyApplication.csproj" ReferenceOutputAssembly="false" Private="false" />
        <ProjectReference Include="../../Arc/Arc.csproj" />
        <ProjectReference Include="TestArtifacts/AssemblyNameMismatchDependency/AssemblyNameMismatchDependency.csproj" />
        <ProjectReference Include="TestArtifacts/CommandResponseHandlerDependency/CommandResponseHandlerDependency.csproj" />
        <ProjectReference Include="TestArtifacts/FakeCommandResponseHandlerDependency/FakeCommandResponseHandlerDependency.csproj" Aliases="FakeContracts" />
        <ProjectReference Include="TestArtifacts/ReferencedConceptCommand/ReferencedConceptCommand.csproj" />
        <ProjectReference Include="TestArtifacts/ReferencedConceptValidator/ReferencedConceptValidator.csproj" />
        <ProjectReference Include="TestArtifacts/TransitiveConceptValidator/TransitiveConceptValidator.csproj" />
        <ProjectReference Include="TestArtifacts/SourceFileResolverFixture/SourceFileResolverFixture.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.ClearScript.V8" />
        <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'" />
        <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'" />
        <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'" />
        <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'" />
        <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'" />
        <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="$(MSBuildThisFileDirectory)../../GlobalUsings.Specs.cs" />
        <Compile Remove="TestArtifacts/**/*.cs" />
        <Compile Include="../../Arc.Core.Specs/Queries/ModelBound/for_ModelBoundQueryMethod/given/*.cs" Link="ModelBound/for_TypeExtensionsModelBound/SelectionFixtures/%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Scenarios\Infrastructure\arc-bootstrap.js" Condition="Exists('Scenarios\Infrastructure\arc-bootstrap.js')" />
    </ItemGroup>
    <ItemGroup>
        <!-- The scenario specs compile generated TypeScript in-process through ClearScript's V8 engine, which
             requires the classic JavaScript-based TypeScript compiler (lib/typescript.js). TypeScript 7 ships a
             native compiler that no longer exposes lib/typescript.js, so prefer the classic 'typescript-for-eslint'
             alias (npm:typescript@6.0.3) when present, and fall back to the root 'typescript' package for
             environments that still resolve a classic TypeScript. Either source lands at the same TargetPath the
             runtime fixture reads. -->
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/typescript-for-eslint/lib/typescript.js"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/typescript-for-eslint/lib/typescript.js')">
            <TargetPath>node_modules/typescript/lib/typescript.js</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/typescript-for-eslint/lib/lib*.d.ts"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/typescript-for-eslint/lib')">
            <TargetPath>node_modules/typescript/lib/%(Filename)%(Extension)</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/typescript/lib/typescript.js"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/typescript/lib/typescript.js') AND !Exists('$(MSBuildThisFileDirectory)../../../../node_modules/typescript-for-eslint/lib/typescript.js')">
            <TargetPath>node_modules/typescript/lib/typescript.js</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/typescript/lib/lib*.d.ts"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/typescript/lib') AND !Exists('$(MSBuildThisFileDirectory)../../../../node_modules/typescript-for-eslint/lib/typescript.js')">
            <TargetPath>node_modules/typescript/lib/%(Filename)%(Extension)</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/@cratis/fundamentals/package.json"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/@cratis/fundamentals/package.json')">
            <TargetPath>node_modules/@cratis/fundamentals/package.json</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/@cratis/fundamentals/dist/cjs/**/*"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/@cratis/fundamentals/dist/cjs')">
            <TargetPath>node_modules/@cratis/fundamentals/dist/cjs/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/@cratis/fundamentals/dist/esm/**/*.d.ts"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/@cratis/fundamentals/dist/esm')">
            <TargetPath>node_modules/@cratis/fundamentals/dist/esm/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </ProxyJavaScriptDependency>
        <ProxyJavaScriptDependency Include="$(MSBuildThisFileDirectory)../../../../node_modules/rxjs/dist/cjs/**/*"
                                   Condition="Exists('$(MSBuildThisFileDirectory)../../../../node_modules/rxjs/dist/cjs')">
            <TargetPath>node_modules/rxjs/dist/cjs/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </ProxyJavaScriptDependency>
    </ItemGroup>
    <PropertyGroup>
        <ArcJavaScriptPath>$(MSBuildThisFileDirectory)../../../JavaScript/Arc</ArcJavaScriptPath>
        <ArcReactJavaScriptPath>$(MSBuildThisFileDirectory)../../../JavaScript/Arc.React</ArcReactJavaScriptPath>
        <ArcJavaScriptRoot>$(MSBuildThisFileDirectory)../../../../</ArcJavaScriptRoot>
    </PropertyGroup>
    <ItemGroup>
        <!-- Everything that influences the output of `yarn build` for each package (tsc -b + rollup). -->
        <_ArcJavaScriptInput Include="$(ArcJavaScriptPath)/**/*.ts;$(ArcJavaScriptPath)/**/*.tsx;$(ArcJavaScriptPath)/package.json;$(ArcJavaScriptPath)/tsconfig*.json;$(ArcJavaScriptPath)/rollup.config.mjs"
                               Exclude="$(ArcJavaScriptPath)/node_modules/**;$(ArcJavaScriptPath)/dist/**" />
        <_ArcJavaScriptInput Include="$(ArcJavaScriptRoot)package.json;$(ArcJavaScriptRoot)yarn.lock;$(ArcJavaScriptRoot)tsconfig.json;$(ArcJavaScriptRoot)rollup.config.mjs;$(ArcJavaScriptRoot)global.d.ts;$(ArcJavaScriptRoot)test.d.ts" Condition="Exists('$(ArcJavaScriptRoot)yarn.lock')" />
        <_ArcReactJavaScriptInput Include="$(ArcReactJavaScriptPath)/**/*.ts;$(ArcReactJavaScriptPath)/**/*.tsx;$(ArcReactJavaScriptPath)/package.json;$(ArcReactJavaScriptPath)/tsconfig*.json;$(ArcReactJavaScriptPath)/rollup.config.mjs"
                                    Exclude="$(ArcReactJavaScriptPath)/node_modules/**;$(ArcReactJavaScriptPath)/dist/**" />
        <_ArcReactJavaScriptInput Include="@(_ArcJavaScriptInput)" Exclude="$(ArcJavaScriptPath)/**" />
    </ItemGroup>
    <Target Name="InitializeJavaScriptBuild">
        <!-- Resolve paths after the SDK has set the configuration/TFM-specific intermediate directory. -->
        <PropertyGroup>
            <ArcJavaScriptStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'arc-js.stamp'))</ArcJavaScriptStamp>
            <ArcReactJavaScriptStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'arc-react-js.stamp'))</ArcReactJavaScriptStamp>
        </PropertyGroup>
        <ItemGroup>
            <FileWrites Include="$(ArcJavaScriptStamp);$(ArcReactJavaScriptStamp)" />
        </ItemGroup>
    </Target>
    <Target Name="PrepareArcReactJavaScriptInputs" DependsOnTargets="BuildArcJavaScriptPackage">
        <!-- Include declarations even when Arc was built outside this project's targets. -->
        <ItemGroup>
            <_ArcReactJavaScriptInput Include="$(ArcJavaScriptStamp);$(ArcJavaScriptPath)/dist/esm/**/*.d.ts" />
        </ItemGroup>
    </Target>
    <Target Name="CleanJavaScriptBuildStamps" AfterTargets="Clean" DependsOnTargets="InitializeJavaScriptBuild">
        <Delete Files="$(ArcJavaScriptStamp);$(ArcReactJavaScriptStamp)" />
    </Target>
    <!-- Incremental: skipped when the stamp and the dist entry are newer than every input. A missing dist entry or stamp forces a rebuild. -->
    <Target Name="BuildArcJavaScriptPackage"
            BeforeTargets="BeforeBuild"
            DependsOnTargets="InitializeJavaScriptBuild"
            Condition="'$(TargetFramework)' != ''"
            Inputs="@(_ArcJavaScriptInput)"
            Outputs="$(ArcJavaScriptStamp);$(ArcJavaScriptPath)/dist/esm/index.js">
        <Message Text="Building @cratis/arc JavaScript package..." Importance="high" />
        <Delete Files="$(ArcJavaScriptStamp)" />
        <Exec Command="yarn build" WorkingDirectory="$(ArcJavaScriptPath)" />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ArcJavaScriptStamp)'))" />
        <Touch Files="$(ArcJavaScriptStamp)" AlwaysCreate="true" />
    </Target>
    <Target Name="BuildArcReactJavaScriptPackage"
            BeforeTargets="BeforeBuild"
            DependsOnTargets="PrepareArcReactJavaScriptInputs"
            Condition="'$(TargetFramework)' != ''"
            Inputs="@(_ArcReactJavaScriptInput)"
            Outputs="$(ArcReactJavaScriptStamp);$(ArcReactJavaScriptPath)/dist/esm/index.js">
        <Message Text="Building @cratis/arc.react JavaScript package..." Importance="high" />
        <Delete Files="$(ArcReactJavaScriptStamp)" />
        <Exec Command="yarn build" WorkingDirectory="$(ArcReactJavaScriptPath)" />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ArcReactJavaScriptStamp)'))" />
        <Touch Files="$(ArcReactJavaScriptStamp)" AlwaysCreate="true" />
    </Target>
    <Target Name="CopyProxyJavaScriptDependencies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="@(ProxyJavaScriptDependency)"
              DestinationFiles="@(ProxyJavaScriptDependency->'$(OutDir)%(TargetPath)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
