<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <TargetFrameworkFolder Condition=" '$(TargetFramework)' == 'net8.0' ">net8.0</TargetFrameworkFolder>
        <TargetFrameworkFolder Condition=" '$(TargetFramework)' == 'net9.0' ">net9.0</TargetFrameworkFolder>
        <TargetFrameworkFolder Condition=" '$(TargetFramework)' == 'net10.0' ">net10.0</TargetFrameworkFolder>

        <!-- Newer consumers (net11.0, net11.0-windows, later) run the net10.0 tool, rolled forward onto the consumer's runtime. -->
        <CratisProxyGeneratorRollForward Condition=" '$(TargetFrameworkFolder)' == '' and '$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0')) ">true</CratisProxyGeneratorRollForward>
        <TargetFrameworkFolder Condition=" '$(CratisProxyGeneratorRollForward)' == 'true' ">net10.0</TargetFrameworkFolder>
        <CratisProxyGeneratorHostArguments Condition=" '$(CratisProxyGeneratorRollForward)' == 'true' and '$(CratisProxyGeneratorHostArguments)' == '' ">--roll-forward LatestMajor</CratisProxyGeneratorHostArguments>
        <!-- Until the 11 runtime ships as a release, the host only rolls forward onto it when prereleases are allowed. -->
        <CratisProxyGeneratorEnvironmentVariables Condition=" '$(CratisProxyGeneratorRollForward)' == 'true' and '$(CratisProxyGeneratorEnvironmentVariables)' == '' ">DOTNET_ROLL_FORWARD_TO_PRERELEASE=1</CratisProxyGeneratorEnvironmentVariables>

        <CratisProxyDevAssemblyDirectory>$(MSBuildThisFileDirectory)../../ProxyGenerator.Build/bin/$(Configuration)/$(TargetFrameworkFolder)</CratisProxyDevAssemblyDirectory>
        <CratisProxyPackedAssemblyDirectory>$(MSBuildThisFileDirectory)../tasks/$(TargetFrameworkFolder)</CratisProxyPackedAssemblyDirectory>

        <CratisProxyGeneratorAssemblyDirectory Condition="Exists($(CratisProxyPackedAssemblyDirectory)) == true">$(CratisProxyPackedAssemblyDirectory)</CratisProxyGeneratorAssemblyDirectory>
        <CratisProxyGeneratorAssemblyDirectory Condition="Exists($(CratisProxyPackedAssemblyDirectory)) == false">$(CratisProxyDevAssemblyDirectory)</CratisProxyGeneratorAssemblyDirectory>
        <CratisProxyGeneratorAssembly>Cratis.Arc.ProxyGenerator.Build.dll</CratisProxyGeneratorAssembly>
    </PropertyGroup>
    
    <Target Name="CratisProxyGeneratorStateFile" BeforeTargets="CratisProxyGenerator;_CleanGetCurrentAndPriorFileWrites">
        <PropertyGroup>
            <_CratisProxiesStateFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)','$(IntermediateOutputPath)','cratis-proxies.state.json'))</_CratisProxiesStateFile>
        </PropertyGroup>
        <ItemGroup>
            <FileWrites Include="$(_CratisProxiesStateFile)" />
        </ItemGroup>
    </Target>

    <Target Name="CratisProxyGeneratorOutputPathNotSet" AfterTargets="AfterBuild" Condition="'$(CratisProxiesOutputPath)' == '' and '$(CratisProxiesSuppressOutputPathMessage)' != 'true'">
        <!-- A message, not a warning, so consumers building with TreatWarningsAsErrors are not broken. -->
        <Message Importance="high" Text="Cratis Arc proxy generation is off: CratisProxiesOutputPath is not set, so no TypeScript proxies are generated. Set it in the project, for example &lt;CratisProxiesOutputPath&gt;%24(MSBuildThisFileDirectory)src&lt;/CratisProxiesOutputPath&gt;. Backend-only projects can silence this message with &lt;CratisProxiesSuppressOutputPathMessage&gt;true&lt;/CratisProxiesSuppressOutputPathMessage&gt;." />
    </Target>

    <Target Name="CratisProxyGenerator" AfterTargets="AfterBuild" Condition="'$(CratisProxiesOutputPath)' != ''"> 
        <PropertyGroup>
            <CratisProxiesOutputPath>$([System.String]::Copy('$(CratisProxiesOutputPath)').TrimEnd('\'))</CratisProxiesOutputPath>
            <!-- In-repo projects import these targets without the package .props. -->
            <CratisProxiesFramework Condition=" '$(CratisProxiesFramework)' == '' ">react</CratisProxiesFramework>
        </PropertyGroup>

        <Message Text="MSBuildProjectDirectory : $(MSBuildProjectDirectory)" Importance="high" />
        <Message Text="OutputPath : $(OutputPath)" Importance="high" />
        <Message Text="ProxiesOutputPath : $(CratisProxiesOutputPath)" Importance="high" />
        <Message Text="AssemblyName : $(AssemblyName)" Importance="high" />
        <Message Text="ProxyGenerator base directory : $(CratisProxyGeneratorAssemblyDirectory)" Importance="high" />
        <Message Text="Full path to assembly : $(MSBuildProjectDirectory)/$(OutputPath)$(AssemblyName).dll" Importance="high" />
        
        <PropertyGroup>
            <!-- Encode before shell transport: copyright text may contain quotes, newlines, or shell syntax. -->
            <CratisProxiesEncodedFileHeader>$([MSBuild]::ConvertToBase64($(CratisProxiesFileHeader)))</CratisProxiesEncodedFileHeader>
            <StateFileArgument Condition=" '$(CratisProxiesIncremental)' != 'false' ">--state-file=&quot;$(_CratisProxiesStateFile)&quot;</StateFileArgument>
            <LibraryMode Condition=" '$(CratisProxiesLibraryMode)' == 'true' ">--library-mode</LibraryMode>
            <SkipOutputDeletion Condition=" '$(CratisProxiesSkipOutputDeletion)' == 'true' ">--skip-output-deletion</SkipOutputDeletion>
            <SkipCommandNameInRoute Condition=" '$(CratisProxiesSkipCommandNameInRoute)' == 'true' ">--skip-command-name-in-route</SkipCommandNameInRoute>
            <SkipQueryNameInRoute Condition=" '$(CratisProxiesSkipQueryNameInRoute)' == 'true' ">--skip-query-name-in-route</SkipQueryNameInRoute>
            <ApiPrefix Condition=" '$(CratisProxiesApiPrefix)' != '' ">--api-prefix=$(CratisProxiesApiPrefix)</ApiPrefix>
            <EndpointGroup Condition=" '$(CratisProxiesEndpointGroup)' != '' ">--endpoint-group=$(CratisProxiesEndpointGroup)</EndpointGroup>
            <SkipFileIndexTracking Condition=" '$(CratisProxiesSkipFileIndexTracking)' == 'true' ">--skip-file-index-tracking</SkipFileIndexTracking>
            <SkipIndexGeneration Condition=" '$(CratisProxiesSkipIndexGeneration)' == 'true' ">--skip-index-generation</SkipIndexGeneration>
            <UseSourceFileAsOutputFile Condition=" '$(CratisProxiesUseSourceFileAsOutputFile)' == 'true' ">--use-source-file-as-output-file</UseSourceFileAsOutputFile>
            <EmitInterfaces Condition=" '$(CratisProxiesEmitInterfaces)' == 'true' ">--emit-interfaces</EmitInterfaces>
            <UseProxyFileSuffix Condition=" '$(CratisProxiesUseProxyFileSuffix)' == 'true' ">--use-proxy-file-suffix</UseProxyFileSuffix>
            <AssemblyPackageMappings>@(AssemblyToPackageMapping -> '--assembly-to-package=%(Assembly)=%(Package)', ' ')</AssemblyPackageMappings>
            <ExcludeTypes>@(ExcludeType -> '--exclude-type=%(TypeName)', ' ')</ExcludeTypes>
            <ExcludeNamespaces>@(ExcludeNamespace -> '--exclude-namespace=%(Namespace)', ' ')</ExcludeNamespaces>
            <NamespaceRoots>@(NamespaceRoot -> '--namespace-root=%(Namespace)=%(Folder)', ' ')</NamespaceRoots>
            <!-- Quoted, unlike the items above, because a TypeScript type is the one metadata value here that
                 legitimately contains a space: Record<string, number>, string | null, { a: number }. Unquoted,
                 the shell split that into two arguments, the first still parsed as a valid mapping with the
                 TsType truncated at the space, and the generator emitted that truncation as the property's type
                 with no diagnostic anywhere. -->
            <TypeMappings>@(TypeToTsType -> '&quot;--type-to-ts=%(TypeName)=%(TsType)=%(Package)&quot;', ' ')</TypeMappings>
        </PropertyGroup>

        <Exec ConsoleToMsBuild="true"
            EnvironmentVariables="$(CratisProxyGeneratorEnvironmentVariables)"
            Command="dotnet $(CratisProxyGeneratorHostArguments) $(CratisProxyGeneratorAssembly) &quot;$(MSBuildProjectDirectory)/$(OutputPath)$(AssemblyName).dll&quot; &quot;$(CratisProxiesOutputPath)&quot; $(CratisProxiesSegmentsToSkip) $(LibraryMode) $(SkipOutputDeletion) $(SkipCommandNameInRoute) $(SkipQueryNameInRoute) $(ApiPrefix) $(EndpointGroup) --project-directory=&quot;$(MSBuildProjectDirectory)&quot; --file-header-base64=$(CratisProxiesEncodedFileHeader) $(SkipFileIndexTracking) $(SkipIndexGeneration) $(UseSourceFileAsOutputFile) $(EmitInterfaces) --framework=&quot;$(CratisProxiesFramework)&quot; $(UseProxyFileSuffix) $(AssemblyPackageMappings) $(ExcludeTypes) $(ExcludeNamespaces) $(NamespaceRoots) $(TypeMappings) $(StateFileArgument)"
            WorkingDirectory="$(CratisProxyGeneratorAssemblyDirectory)" />
    </Target>
</Project>
