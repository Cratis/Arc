<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Arc.ProxyGenerator</AssemblyName>
        <RootNamespace>Cratis.Arc.ProxyGenerator</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <DefineConstants>$(DefineConstants);METADATA_QUERY_ATTRIBUTES</DefineConstants>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>proxygenerator</ToolCommandName>
        <Description>dotnet tool that generates TypeScript proxies, referenced types, and validation metadata for Cratis Arc commands and queries.</Description>
        <PackageTags>cratis;arc;cqrs;typescript;proxy-generation;dotnet-tool;commands;queries;aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)/Templates/**/*.hbs" />
        <InternalsVisibleTo Include="Cratis.Arc.ProxyGenerator.Specs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="handlebars.net" />
        <PackageReference Include="Microsoft.Extensions.DependencyModel" />
        <PackageReference Include="System.Reflection.MetadataLoadContext" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/UnionCaseConvention.cs" Link="Commands/UnionCaseConvention.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/QueryArgumentsModelConvention.cs" Link="Queries/QueryArgumentsModelConvention.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/QueryArgumentDescriptor.cs" Link="Queries/QueryArgumentDescriptor.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/ModelBoundQueryMethod.cs" Link="Queries/ModelBound/ModelBoundQueryMethod.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/MetadataQueryAttributes.cs" Link="Queries/ModelBound/MetadataQueryAttributes.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/QuerySelectionPolicy.cs" Link="Queries/ModelBound/QuerySelectionPolicy.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)../../Shared/SliceNamespace.cs" Link="Slices/SliceNamespace.cs" />
        <!-- The data model of the availability manifest file, shared so the build writes the very format the engine reads. -->
        <Compile Include="$(MSBuildThisFileDirectory)../../Arc.Availability/ManifestFile/*.cs"
                 Exclude="$(MSBuildThisFileDirectory)../../Arc.Availability/ManifestFile/ManifestExpressions.cs;$(MSBuildThisFileDirectory)../../Arc.Availability/ManifestFile/ManifestFileBuilder.cs;$(MSBuildThisFileDirectory)../../Arc.Availability/ManifestFile/ManifestFileEvaluator.cs;$(MSBuildThisFileDirectory)../../Arc.Availability/ManifestFile/ManifestContext.cs"
                 Link="Availability/%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
