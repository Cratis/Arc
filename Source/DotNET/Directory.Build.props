<Project>
    <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props" />

    <PropertyGroup>
        <Version>1.0.0</Version>
        <Copyright>Copyright Cratis</Copyright>
        <Authors>Cratis</Authors>
        <Company>Cratis</Company>
        <DebugType>portable</DebugType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/Cratis/Arc</RepositoryUrl>
        <PackageProjectUrl>https://www.cratis.io/arc/</PackageProjectUrl>
        <PackageIcon>logo.png</PackageIcon>

        <GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>true</GenerateAssemblyDescriptionAttribute>

        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsTestProject Condition="!$(MSBuildProjectName.EndsWith('.Specs'))">false</IsTestProject>
        <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Specs')) OR '$(MSBuildProjectName)'=='PackageGraph.Integration'">true</IsTestProject>

        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <!-- Projects under a .Specs directory (spec projects and their fixture projects) are never published. -->
        <IsPackable Condition="!$(MSBuildProjectDirectory.Contains('.Specs'))">true</IsPackable>
        <IsPackable Condition="$(MSBuildProjectDirectory.Contains('.Specs'))">false</IsPackable>
        <PackageTags Condition="'$(PackageTags)' == ''">cratis;arc;cqrs;commands;queries;aspnetcore;typescript;proxy-generation;event-sourcing</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>False</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>False</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>True</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>True</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>True</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>False</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)/../../README.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)/../../logo.png" Pack="true" PackagePath="/" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalAssemblyInfo.cs" />
    </ItemGroup>

    <!-- Disable the old Microsoft.Extensions.Logging.Generators to prevent duplicate implementations
         when both it and Microsoft.Gen.Logging (newer generator) are present.
         The old generator from Microsoft.Extensions.Logging.Abstractions conflicts with the new one. -->
    <Target Name="RemoveOldLoggingGenerator" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::new('%(Analyzer.Identity)').Contains('Microsoft.Extensions.Logging.Generators.dll'))" />
        </ItemGroup>
        <Message Text="Removed old logging generators: @(Analyzer -> '%(Identity)')" Importance="high" Condition="$([System.String]::new('%(Analyzer.Identity)').Contains('Microsoft.Extensions.Logging.Generators.dll'))" />
    </Target>

    <ItemGroup Condition="'$(IsTestProject)'=='true'">
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalUsings.Specs.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsTestProject)'=='true'">
        <!-- Specifications 5 targets net10.0; fixture and shipping library defaults stay unchanged. -->
        <TargetFrameworks Condition="'$(TargetFramework)'==''">net10.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <WarningsAsErrors>$(WarningsAsErrors);CRSPEC0008</WarningsAsErrors>
        <NoWarn>$(NoWarn);IDE1006;IDE0005;MA0101;RCS1266;xUnit1031</NoWarn>
    </PropertyGroup>
</Project>
