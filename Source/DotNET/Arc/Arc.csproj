<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc</AssemblyName>
        <RootNamespace>Cratis.Arc</RootNamespace>
        <Description>Opinionated CQRS application framework for ASP.NET Core with commands, queries, validation, authorization, and TypeScript proxy generation. Works without event sourcing; Chronicle integration is optional.</Description>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Arc.Specs" />
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Metrics.Roslyn" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Arc.Core\Arc.Core.csproj" />
    </ItemGroup>
</Project>
