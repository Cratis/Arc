<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Chronicle.Specs</AssemblyName>
        <RootNamespace>Cratis.Arc.Chronicle</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <!-- Legacy specs intentionally exercise invalid event and model-bound shapes; Chronicle analyzers
             flag these test fixtures, but production projects retain their full diagnostic coverage. -->
        <NoWarn>$(NoWarn);CHR0001;CHR0003;CHR0021;CHR0024;CHR0027</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <ProjectReference Include="../Arc/Arc.csproj" />
        <ProjectReference Include="../Chronicle/Chronicle.csproj" />
        <ProjectReference Include="../Chronicle.Testing/Chronicle.Testing.csproj" />
    </ItemGroup>
</Project>
