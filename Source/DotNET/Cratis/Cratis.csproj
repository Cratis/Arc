<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis</AssemblyName>
        <RootNamespace>Cratis</RootNamespace>
        <Description>Simplified setup for Cratis Arc applications with Chronicle event sourcing and MongoDB storage</Description>
        <PackageTags>cratis;arc;chronicle;event-sourcing;cqrs;mongodb</PackageTags>
        <NoWarn>$(NoWarn);IDE0005</NoWarn>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Arc/Arc.csproj" />
        <ProjectReference Include="../Chronicle/Chronicle.csproj" />
        <ProjectReference Include="../Swagger/Swagger.csproj" />
        <!-- The meta-package brings the embedded event model with it: documents are generated by the package's own
             build targets, and UseCratis exposes the explorer for a Debug-built application. -->
        <ProjectReference Include="../Screenplay.Embedded/Screenplay.Embedded.csproj" />
        <!-- Build the private MSBuild task beside the metapackage so prepared package outputs can be packed with
             no-build. It is a build input for Screenplay.Embedded's package, not a dependency of Cratis. -->
        <ProjectReference Include="../Tools/Screenplay.Embedded.Build/Screenplay.Embedded.Build.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <!-- The alias hides the build-time tool from Cratis's source compilation, while compile/runtime private assets
             prevent its executable assembly from flowing through the project-reference graph into applications. Keep
             the reference output enabled so NuGet retains ProxyGenerator.Build as a package dependency; only its
             build/buildTransitive assets should flow from the packed Cratis meta-package. -->
        <ProjectReference Include="../Tools/ProxyGenerator.Build/ProxyGenerator.Build.csproj"
                          Aliases="ProxyGeneratorBuild"
                          PrivateAssets="compile;runtime" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Chronicle.AspNetCore" />
    </ItemGroup>
    <ItemGroup>
        <None Include="GlobalUsings.cs" Pack="true" PackagePath="contentFiles/cs/any" />
        <None Include="build/Cratis.props" Pack="true" PackagePath="build;buildTransitive" />
    </ItemGroup>

</Project>
