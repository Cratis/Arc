<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Chronicle</AssemblyName>
        <RootNamespace>Cratis.Arc.Chronicle</RootNamespace>
        <Description>Optional Cratis Chronicle event-sourcing integration for Cratis Arc: event-sourced commands, projections, reducers, aggregates, reactors, and tenant namespaces for CQRS applications on ASP.NET Core.</Description>
        <PackageTags>cratis;arc;chronicle;event-sourcing;event-store;cqrs;commands;queries;aspnetcore</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Arc.Chronicle.Specs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Arc.Core/Arc.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="System.Collections.Immutable" />
        <PackageReference Include="Cratis.Chronicle" />
    </ItemGroup>

    <ItemGroup>
        <!-- Public package dependency for consumers; the direct analyzer reference is only for analyzing
             Arc.Chronicle while building from source. -->
        <ProjectReference Include="../Chronicle.CodeAnalysis.Package/Chronicle.CodeAnalysis.Package.csproj"
                          PrivateAssets="compile;runtime" />
        <ProjectReference Include="../Chronicle.CodeAnalysis/Chronicle.CodeAnalysis.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>
</Project>
