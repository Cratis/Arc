<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Screenplay</AssemblyName>
        <RootNamespace>Cratis.Arc.Screenplay</RootNamespace>
        <Description>Generates a Cratis Screenplay .play file from the source of a Cratis Arc application</Description>
        <PackageTags>cratis;arc;screenplay;event-modeling;play</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Arc.Screenplay.Specs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Screenplay" />
        <PackageReference Include="Cratis.Screenplay.Generation.Contracts" />
        <PackageReference Include="Cratis.Screenplay.Generation.DotNet" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <Compile Include="../Shared/ModelBoundQueryMethodSymbols.cs" Link="ModelBoundQueryMethodSymbols.cs" />
        <Compile Include="../Shared/QuerySelectionPolicy.cs" Link="QuerySelectionPolicy.cs" />
        <Compile Include="../Shared/AttributePrecedencePolicy.cs" Link="AttributePrecedencePolicy.cs" />
        <Compile Include="../Shared/CommandAttributeSymbols.cs" Link="CommandAttributeSymbols.cs" />
        <AdditionalFiles Include="../Arc.Core.Generators/AnalyzerReleases.Shipped.md" Link="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="../Arc.Core.Generators/AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
</Project>
