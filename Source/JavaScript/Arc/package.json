{
    "type": "module",
    "name": "@cratis/arc",
    "version": "1.0.0",
    "description": "TypeScript command, query, validation, identity, and messaging runtime for Cratis Arc — the CQRS application framework for ASP.NET Core — used by generated proxies.",
    "keywords": [
        "cratis",
        "arc",
        "cqrs",
        "commands",
        "queries",
        "typescript",
        "proxy",
        "validation",
        "aspnetcore",
        "event-sourcing"
    ],
    "homepage": "https://www.cratis.io/arc/",
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Arc.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "**/*.ts",
        "**/*.tsx"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./commands": {
            "import": {
                "types": "./dist/esm/commands/index.d.ts",
                "default": "./dist/esm/commands/index.js"
            },
            "require": {
                "types": "./dist/cjs/commands/index.d.ts",
                "default": "./dist/cjs/commands/index.js"
            }
        },
        "./identity": {
            "import": {
                "types": "./dist/esm/identity/index.d.ts",
                "default": "./dist/esm/identity/index.js"
            },
            "require": {
                "types": "./dist/cjs/identity/index.d.ts",
                "default": "./dist/cjs/identity/index.js"
            }
        },
        "./messaging": {
            "import": {
                "types": "./dist/esm/messaging/index.d.ts",
                "default": "./dist/esm/messaging/index.js"
            },
            "require": {
                "types": "./dist/cjs/messaging/index.d.ts",
                "default": "./dist/cjs/messaging/index.js"
            }
        },
        "./queries": {
            "import": {
                "types": "./dist/esm/queries/index.d.ts",
                "default": "./dist/esm/queries/index.js"
            },
            "require": {
                "types": "./dist/cjs/queries/index.d.ts",
                "default": "./dist/cjs/queries/index.js"
            }
        },
        "./validation": {
            "import": {
                "types": "./dist/esm/validation/index.d.ts",
                "default": "./dist/esm/validation/index.js"
            },
            "require": {
                "types": "./dist/cjs/validation/index.d.ts",
                "default": "./dist/cjs/validation/index.js"
            }
        },
        "./reflection": {
            "import": {
                "types": "./dist/esm/reflection/index.d.ts",
                "default": "./dist/esm/reflection/index.js"
            },
            "require": {
                "types": "./dist/cjs/reflection/index.d.ts",
                "default": "./dist/cjs/reflection/index.js"
            }
        }
    },
    "scripts": {
        "prepare": "yarn g:build",
        "clean": "yarn g:clean",
        "build": "yarn g:build",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "test:watch": "yarn g:test:watch",
        "ci": "yarn g:ci",
        "up": "yarn g:up"
    },
    "dependencies": {
        "@cratis/fundamentals": "^7.19.6",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@cratis/fundamentals": "7.19.6"
    }
}
