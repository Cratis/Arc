{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist/esm",
        "noEmit": false,
        "paths": {
            // Only specs use this unpublished cross-package test helper. Mapping all of @cratis/arc/*
            // makes SWC inline Arc's runtime (and its rxjs imports) into the published React bundle.
            "@cratis/arc/helpers/*": [
                "../Arc/helpers/*"
            ]
        }
    },
    "files": [
        "../../../test.d.ts",
        "../../../global.d.ts",
        "global.d.ts"
    ],
    "include": [
        "**/*.ts",
        "**/*.tsx"
    ],
    "references": [
        {
            "path": "../Arc"
        }
    ],
    "exclude": [
        "dist",
        "vite.config.mts"
    ]
}
