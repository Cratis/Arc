{
    "type": "module",
    "name": "@cratis/arc.react",
    "version": "1.0.0",
    "description": "React hooks, forms, dialogs, identity, and observable query composition for Cratis Arc — the CQRS application framework for ASP.NET Core.",
    "keywords": [
        "cratis",
        "arc",
        "cqrs",
        "commands",
        "queries",
        "react",
        "hooks",
        "forms",
        "typescript",
        "aspnetcore"
    ],
    "homepage": "https://www.cratis.io/arc/",
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Arc.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "**/*.ts",
        "**/*.tsx"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./commands": {
            "import": {
                "types": "./dist/esm/commands/index.d.ts",
                "default": "./dist/esm/commands/index.js"
            },
            "require": {
                "types": "./dist/cjs/commands/index.d.ts",
                "default": "./dist/cjs/commands/index.js"
            }
        },
        "./queries": {
            "import": {
                "types": "./dist/esm/queries/index.d.ts",
                "default": "./dist/esm/queries/index.js"
            },
            "require": {
                "types": "./dist/cjs/queries/index.d.ts",
                "default": "./dist/cjs/queries/index.js"
            }
        },
        "./dialogs": {
            "import": {
                "types": "./dist/esm/dialogs/index.d.ts",
                "default": "./dist/esm/dialogs/index.js"
            },
            "require": {
                "types": "./dist/cjs/dialogs/index.d.ts",
                "default": "./dist/cjs/dialogs/index.js"
            }
        },
        "./messaging": {
            "import": {
                "types": "./dist/esm/messaging/index.d.ts",
                "default": "./dist/esm/messaging/index.js"
            },
            "require": {
                "types": "./dist/cjs/messaging/index.d.ts",
                "default": "./dist/cjs/messaging/index.js"
            }
        },
        "./identity": {
            "import": {
                "types": "./dist/esm/identity/index.d.ts",
                "default": "./dist/esm/identity/index.js"
            },
            "require": {
                "types": "./dist/cjs/identity/index.d.ts",
                "default": "./dist/cjs/identity/index.js"
            }
        },
        "./stories": {
            "import": {
                "types": "./dist/esm/stories/index.d.ts",
                "default": "./dist/esm/stories/index.js"
            },
            "require": {
                "types": "./dist/cjs/stories/index.d.ts",
                "default": "./dist/cjs/stories/index.js"
            }
        },
        "./stories/styles.css": "./dist/esm/stories/stories.css"
    },
    "scripts": {
        "prepare": "yarn g:build",
        "clean": "yarn g:clean",
        "build": "yarn g:build",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "ci": "yarn g:ci",
        "up": "yarn g:up",
        "dev": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@cratis/arc": "1.0.0",
        "@cratis/fundamentals": "^7.19.6",
        "tsyringe": "^4.10.0"
    },
    "devDependencies": {
        "@cratis/fundamentals": "7.19.6",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/react": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@vitejs/plugin-react": "^6.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "storybook": "^10.6.0",
        "vite": "^8.3.1"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    }
}
