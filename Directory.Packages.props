<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!-- Allow pinning vulnerable transitive packages to patched versions via PackageVersion entries below. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive security pins -->
    <!-- SSH.NET through Testcontainers <= 2025.1.0 has a high-severity advisory
         (GHSA-q939-rpr3-3284). Pin the transitive dependency to the patched release. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <!-- SQLitePCLRaw 2.1.10/2.1.11 (pulled in transitively by EF Core Sqlite) has a high-severity advisory
         (GHSA-2m69-gcr7-jv3q). Pin the native library to the patched release. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Microsoft.OpenApi 2.0.0 (pulled in transitively by Microsoft.AspNetCore.OpenApi) has a high-severity
         advisory (GHSA-v5pm-xwqc-g5wc). Pin to the patched 2.x release. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.1" />
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Choreography" Version="2.10.0" />
    <PackageVersion Include="Cratis.Chronicle" Version="19.182.2" />
    <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="19.182.2" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.182.2" />
    <PackageVersion Include="Cratis.Fundamentals" Version="7.34.3" />
    <PackageVersion Include="Cratis.Metrics.Roslyn" Version="7.34.3" />
    <PackageVersion Include="Cratis.Screenplay" Version="6.38.0" />
    <!-- Held at 0.21.2: Cratis.Screenplay.Generation.DotNet 0.22.0 and later require Microsoft.CodeAnalysis.CSharp 5.12.0,
         above the Roslyn 5.9.0 load floor held below for SDK 10.0.400 (#3952). -->
    <PackageVersion Include="Cratis.Screenplay.Generation.Contracts" Version="0.21.2" />
    <PackageVersion Include="Cratis.Screenplay.Generation" Version="0.21.2" />
    <PackageVersion Include="Cratis.Screenplay.Generation.DotNet" Version="0.21.2" />
    <!-- MAUI -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    <!-- Microsoft -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.15" />
    <!-- Keep Orleans Reminders aligned with the server pulled in by Chronicle.Testing. -->
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.4.2" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Held at 2.3.0: 2.4.0 changes JSON-RPC member casing handling, so the McpEndpoint spec "should not dispatch a write through a second name" fails; Arc.Mcp also pins the SDK in its dependency-graph spec. Moving up needs the endpoint hardening reviewed. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- Held at 18.9.6 (with Microsoft.Build.Utilities.Core and Microsoft.NET.StringTools): 18.12.x fails the net10.0 MSBuild task projects with a "does not support net10.0" build error. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />
    <!-- System -->
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.15" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <!-- Pkcs: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx. Pin patched transitive dependencies. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Xml: GHSA-c399-9853-6jmj, GHSA-7hqp-7c5m-4vq6, GHSA-r955-8q5j-3h83. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- Third Party -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!-- Held at 3.13.0: with 3.14.1 the MongoDBWatcher spec "should watch each deployment on a stream of its own" times out; 3.13.0 passes. -->
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Neo4j.Driver" Version="6.5.1" />
    <!-- 0.50.4 is the newest version listed on nuget.org. 1.0.0 exists in the flat container but is
         unlisted, so it is invisible to search and to anyone auditing the dependency - and because
         NuGet still orders it above 0.50.4, depending on it forces every consumer that also pulls a
         package targeting the listed line into an NU1605 downgrade error. -->
    <PackageVersion Include="SharpCompress" Version="0.50.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <!-- Held at 2.4.3: Cratis.Observability.SourceGenerators bundles Handlebars 2.4.3, and 2.5.0 raises an MSB3277 assembly conflict in the projects that consume both. -->
    <PackageVersion Include="handlebars.net" Version="2.4.3" />
    <PackageVersion Include="castle.core" Version="5.2.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.11.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="snappier" Version="1.3.2" />
    <!-- Roslyn.
         The version referenced here becomes a HARD load-floor for consumers: the Arc analyzers and
         source generators (Cratis.Arc.Core.CodeAnalysis, Cratis.Arc.Chronicle.CodeAnalysis,
         Cratis.Arc.Core.Generators) are shipped as Roslyn components, so a consumer whose .NET SDK ships
         an older compiler than this cannot load them and gets CS9057 — silently losing proxy generation
         and all ARC*/ARCCHR* analyzer coverage.
         5.9.0 requires .NET SDK 10.0.400+ (older SDK feature bands ship older Roslyn hosts).
         Raising this floor is a MINOR change and must be stated in the release notes — never slip it in
         on a patch. See the SDK requirement in README.md.
         Held at 5.9.0 in the dependency sweep (#3952): 5.12.0 would raise the floor above the supported SDK 10.0.400. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" Version="1.1.2" />
    <!-- Reading a real project into a compilation, for the end to end check on Screenplay generation.
         Microsoft.Build.Framework is declared above and is referenced with ExcludeAssets="runtime", so that MSBuild
         itself always comes from the SDK that MSBuildLocator registers rather than from an output folder. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <!-- Override vulnerable/incompatible transitive dependencies from analyzer testing packages -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="System.Formats.Asn1" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Composition" Version="1.0.31" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <!-- Held at 3.0.235. Later releases add MA0147 (async void method for delegate), which flags the deliberate Rx callbacks in
         ClientObservable, ClientObservableSSE and ObservableQueryDemultiplexer. Moving up needs those callbacks redesigned, not a version bump alone. -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.235" />
    <!-- Specifications -->
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.3.0" />
    <!-- Held at 4.0.2 (with xunit.v3.extensibility.core): 4.0.3 reports xUnit1073 for the unused collection definition in ProxyGenerator.Specs and breaks the Screenplay.Embedded xunit consumer fixture compile (SP0024). -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <!-- Required at runtime by the Roslyn testing XUnit verifiers; compile assets are excluded where referenced. -->
    <PackageVersion Include="xunit.assert" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Held at 5.x. NSubstitute 6 deadlocks the task-returning DynamicProxy fixtures used by
         MongoCollectionInterceptor. Directory.Build.targets checks this during compilation so
         the package updater cannot publish that incompatible test setup. Moving to 6 requires
         migrating and verifying this interception boundary, not a version bump alone. -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
    <PackageVersion Include="Microsoft.ClearScript.V8.Native.win-arm64" Version="7.5.1.1" />
  </ItemGroup>
  <!-- The net11.0 pins apply to everything except net10.0 and netstandard2.0 (the condition sits on the item group inside the file, because an Import
       condition is evaluated before a single-framework project has set its TargetFramework). The netstandard2.0 analyzers and generators load into
       the consumer's compiler host, so they must not reference System.Collections.Immutable or System.Reflection.Metadata 11, or net10 SDK consumers break. -->
  <Import Project="$(MSBuildThisFileDirectory)/Directory.Packages.NET11.props" />
</Project>