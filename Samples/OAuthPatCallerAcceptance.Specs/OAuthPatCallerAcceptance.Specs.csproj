<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Samples.OAuthPatCallerAcceptance.Specs</AssemblyName>
        <TargetFramework Condition="'$(CratisSpecsTargetFramework)' == ''">net11.0</TargetFramework>
        <TargetFramework Condition="'$(CratisSpecsTargetFramework)' != ''">$(CratisSpecsTargetFramework)</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
        <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors>$(WarningsAsErrors);CRSPEC0008</WarningsAsErrors>
        <NoWarn>$(NoWarn);NETSDK1206;SA0001;SA1600;IDE0005;IDE1006;MA0101;RCS1266;xUnit1031</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="xunit.v3.mtp-off" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../OAuthPatCallerAcceptance/OAuthPatCallerAcceptance.csproj" />
        <Using Include="Cratis.Specifications" />
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
