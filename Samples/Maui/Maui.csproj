<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Directory.Build.props sets TargetFrameworks (net11.0 in Debug, net10.0;net11.0 in Release) when no framework is specified.
             The TargetFrameworks below replace it, and the empty TargetFramework keeps only the MAUI-specific platform targets below apply. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>Samples.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

        <ApplicationId>com.cratis.samples.maui</ApplicationId>
        <ApplicationIdGuid>A7C3E1B2-D4F5-4890-ABCD-EF1234560001</ApplicationIdGuid>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationTitle>Maui</ApplicationTitle>

        <!-- Generate deps.json so DependencyContext assembly discovery works (Arc type scanning) -->
        <GenerateDependencyFile>true</GenerateDependencyFile>

        <!-- Enable AOT and trim analyzers on all platforms so incompatibilities surface during build. -->
        <IsAotCompatible>true</IsAotCompatible>

        <NoWarn>$(NoWarn);SA0001;SA1600;IDE0005;IL2026;IL3050;RCS1102;MA0036</NoWarn>
        <IsPackable>false</IsPackable>

        <!-- Cross-platform yarn command -->
        <YarnCmd Condition="$([MSBuild]::IsOSPlatform('windows'))">yarn.cmd</YarnCmd>
        <YarnCmd Condition="!$([MSBuild]::IsOSPlatform('windows'))">yarn</YarnCmd>
        <ArcCoreFrontendDir>$(MSBuildProjectDirectory)/../ArcCore</ArcCoreFrontendDir>
        <ArcRepositoryRoot Condition="'$(ArcRepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../..'))</ArcRepositoryRoot>
    </PropertyGroup>

    <!-- Mac Catalyst settings -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <!-- Enable NativeAOT for publish. dotnet build still uses Mono for fast iteration;
             only dotnet publish produces a NativeAOT binary with full trimming. -->
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <!-- Windows settings -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <OutputType>WinExe</OutputType>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <!-- No MSIX packaging in Debug — run directly from bin/ -->
        <WindowsPackageType Condition="'$(Configuration)' == 'Debug'">None</WindowsPackageType>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\AppIcon\appicon.svg" Color="#512BD4" BaseSize="128,128" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Source/DotNET/Arc.Core/Arc.Core.csproj" />
        <ProjectReference Include="../../Source/DotNET/Arc.Core.Generators/Arc.Core.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Shared/Shared.csproj" />
    </ItemGroup>

    <!-- Completion stamps are scoped to the SDK's configuration/TFM intermediate directory.
         Real outputs are checked separately: Yarn/TypeScript may preserve their timestamps. -->
    <Target Name="InitializeFrontendBuild">
        <PropertyGroup>
            <FrontendInstallStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'frontend-install.stamp'))</FrontendInstallStamp>
            <FrontendBuildStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'frontend-build.stamp'))</FrontendBuildStamp>
            <_FrontendInstallInventory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'frontend-install.inputs'))</_FrontendInstallInventory>
            <_FrontendBuildInventory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'frontend-build.inputs'))</_FrontendBuildInventory>
            <_FrontendOutputInventory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'frontend-build.outputs'))</_FrontendOutputInventory>
            <_FrontendInputExcludes>$(ArcRepositoryRoot)**/node_modules/**;$(ArcRepositoryRoot)**/dist/**;$(ArcRepositoryRoot)**/bin/**;$(ArcRepositoryRoot)**/obj/**;$(ArcRepositoryRoot)**/wwwroot/**;$(ArcRepositoryRoot)**/.ai-work/**;$(ArcRepositoryRoot)**/.cache/**;$(ArcRepositoryRoot)**/.vite/**;$(ArcRepositoryRoot)**/.yarn/**;$(ArcRepositoryRoot)**/.eslintcache;$(ArcRepositoryRoot)**/*.tsbuildinfo</_FrontendInputExcludes>
        </PropertyGroup>
        <ItemGroup>
            <_FrontendMetadata Include="$(FrontendInstallStamp);$(FrontendBuildStamp);$(_FrontendInstallInventory);$(_FrontendBuildInventory);$(_FrontendOutputInventory)" />
            <FileWrites Include="@(_FrontendMetadata)" />
        </ItemGroup>
    </Target>

    <Target Name="PrepareFrontendInstall" DependsOnTargets="InitializeFrontendBuild">
        <ItemGroup>
            <_FrontendRequiredInstallInput Include="$(ArcRepositoryRoot)package.json;$(ArcRepositoryRoot)yarn.lock;$(ArcRepositoryRoot).yarnrc.yml;$(ArcCoreFrontendDir)/package.json" />
            <_FrontendInstallCandidate Include="$(MSBuildProjectFullPath);@(_FrontendRequiredInstallInput)" />
            <!-- Match the root workspace discovery, including nested workspaces but not generated trees. -->
            <_FrontendInstallCandidate Include="$(ArcRepositoryRoot)Source/**/package.json;$(ArcRepositoryRoot)Samples/**/package.json"
                                       Exclude="$(_FrontendInputExcludes);$(ArcRepositoryRoot)Source/DotNET/Screenplay.Embedded/**" />
            <_FrontendInstallCandidate Include="$(ArcRepositoryRoot).yarn/releases/**;$(ArcRepositoryRoot).yarn/plugins/**" />
            <_FrontendInstallCandidate Include="$(ArcRepositoryRoot)link-eslint-typescript.js" Condition="Exists('$(ArcRepositoryRoot)link-eslint-typescript.js')" />
            <_FrontendInstallInput Include="@(_FrontendInstallCandidate->Metadata('FullPath')->Distinct())" />
        </ItemGroup>
        <Error Condition="!Exists('%(_FrontendRequiredInstallInput.Identity)')" Text="[Maui] Required frontend install input is missing: %(_FrontendRequiredInstallInput.Identity)" />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(FrontendInstallStamp)'))" />
        <!-- Stable full-path inventories detect removals and additions with old timestamps. -->
        <WriteLinesToFile File="$(_FrontendInstallInventory)" Lines="@(_FrontendInstallInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Delete Files="$(FrontendInstallStamp)" Condition="!Exists('$(ArcRepositoryRoot)node_modules/.yarn-state.yml')" />
    </Target>

    <Target Name="InstallFrontend" DependsOnTargets="PrepareFrontendInstall"
            Inputs="@(_FrontendInstallInput);$(_FrontendInstallInventory)" Outputs="$(FrontendInstallStamp)">
        <Message Text="[Maui] Installing frontend dependencies in ArcCore..." Importance="high" />
        <Delete Files="$(FrontendInstallStamp)" />
        <Exec Command="$(YarnCmd) install" WorkingDirectory="$(ArcCoreFrontendDir)" />
        <Error Condition="!Exists('$(ArcRepositoryRoot)node_modules/.yarn-state.yml')" Text="[Maui] Yarn install did not produce node_modules/.yarn-state.yml." />
        <Touch Files="$(FrontendInstallStamp)" AlwaysCreate="true" />
    </Target>

    <Target Name="PrepareFrontendBuild" DependsOnTargets="InstallFrontend">
        <ItemGroup>
            <_FrontendRequiredBuildInput Include="$(ArcRepositoryRoot)tsconfig.json;$(ArcCoreFrontendDir)/tsconfig.json;$(ArcCoreFrontendDir)/index.html;$(ArcCoreFrontendDir)/.frontend/vite.config.ts" />
            <_FrontendBuildCandidate Include="$(MSBuildProjectFullPath);$(FrontendInstallStamp);@(_FrontendRequiredBuildInput)" />
            <_FrontendBuildCandidate Include="$(ArcCoreFrontendDir)/**;$(ArcCoreFrontendDir)/.frontend/**;$(ArcCoreFrontendDir)/../Shared/**"
                                     Exclude="$(_FrontendInputExcludes);$(ArcCoreFrontendDir)/../Shared/**/*.cs;$(ArcCoreFrontendDir)/../Shared/**/*.csproj;$(ArcCoreFrontendDir)/**/*.cs;$(ArcCoreFrontendDir)/**/*.csproj" />
            <_FrontendBuildCandidate Include="$(ArcRepositoryRoot)Source/JavaScript/Arc/**;$(ArcRepositoryRoot)Source/JavaScript/Arc.React/**"
                                     Exclude="$(_FrontendInputExcludes)" />
            <!-- Referenced declarations can change independently of this project's install/build stamps. -->
            <_FrontendBuildCandidate Include="$(ArcRepositoryRoot)Source/JavaScript/Arc/dist/esm/**/*.d.ts;$(ArcRepositoryRoot)Source/JavaScript/Arc.React/dist/esm/**/*.d.ts;$(ArcRepositoryRoot)tsconfig*.json;$(ArcRepositoryRoot)*.config.*" />
            <_FrontendBuildCandidate Include="$(ArcRepositoryRoot)global.d.ts" Condition="Exists('$(ArcRepositoryRoot)global.d.ts')" />
            <_FrontendBuildCandidate Include="$(ArcRepositoryRoot)test.d.ts" Condition="Exists('$(ArcRepositoryRoot)test.d.ts')" />
            <_FrontendBuildCandidate Include="$(ArcRepositoryRoot)run-task-on-workspaces.js" Condition="Exists('$(ArcRepositoryRoot)run-task-on-workspaces.js')" />
            <_FrontendBuildInput Include="@(_FrontendBuildCandidate->Metadata('FullPath')->Distinct())" />
        </ItemGroup>
        <Error Condition="!Exists('%(_FrontendRequiredBuildInput.Identity)')" Text="[Maui] Required frontend build input is missing: %(_FrontendRequiredBuildInput.Identity)" />
        <WriteLinesToFile File="$(_FrontendBuildInventory)" Lines="@(_FrontendBuildInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ReadLinesFromFile File="$(_FrontendOutputInventory)" Condition="Exists('$(_FrontendOutputInventory)')">
            <Output TaskParameter="Lines" ItemName="_FrontendPreviousOutput" />
        </ReadLinesFromFile>
        <ItemGroup>
            <_FrontendMissingOutput Include="@(_FrontendPreviousOutput)" Condition="!Exists('%(Identity)')" />
        </ItemGroup>
        <Delete Files="$(FrontendBuildStamp)" Condition="!Exists('$(ArcCoreFrontendDir)/wwwroot/index.html') Or !Exists('$(_FrontendOutputInventory)') Or '@(_FrontendPreviousOutput)' == '' Or '@(_FrontendMissingOutput)' != ''" />
    </Target>

    <Target Name="BuildFrontend" DependsOnTargets="PrepareFrontendBuild"
            Inputs="@(_FrontendBuildInput);$(_FrontendBuildInventory)" Outputs="$(FrontendBuildStamp)">
        <Message Text="[Maui] Building ArcCore frontend..." Importance="high" />
        <Delete Files="$(FrontendBuildStamp)" />
        <Exec Command="$(YarnCmd) build" WorkingDirectory="$(ArcCoreFrontendDir)" />
        <Error Condition="!Exists('$(ArcCoreFrontendDir)/wwwroot/index.html')" Text="[Maui] Frontend build did not produce wwwroot/index.html." />
        <ItemGroup>
            <_FrontendEmittedOutput Include="$(ArcCoreFrontendDir)/wwwroot/**" />
        </ItemGroup>
        <WriteLinesToFile File="$(_FrontendOutputInventory)" Lines="@(_FrontendEmittedOutput->Metadata('FullPath')->Distinct())" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Touch Files="$(FrontendBuildStamp)" AlwaysCreate="true" />
    </Target>

    <!-- Collect at execution time, before SDK content metadata/copy discovery, even on a skipped build. -->
    <Target Name="CollectFrontendContent" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildFrontend"
            Condition="'$(IsCrossTargetingBuild)' != 'true'">
        <ItemGroup>
            <Content Remove="$(ArcCoreFrontendDir)/wwwroot/**" />
            <_FrontendContent Include="$(ArcCoreFrontendDir)/wwwroot/**" />
            <Content Include="@(_FrontendContent)"
                     Link="wwwroot/%(_FrontendContent.RecursiveDir)%(_FrontendContent.Filename)%(_FrontendContent.Extension)"
                     CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <Target Name="CleanFrontendBuildStamps" AfterTargets="Clean" DependsOnTargets="InitializeFrontendBuild">
        <Delete Files="@(_FrontendMetadata)" />
    </Target>

    <!-- Mac Catalyst: copy deps.json into Contents/MonoBundle/ inside the app bundle.
         DependencyContext.Default reads the deps.json from the same directory as the
         main assembly (AppContext.BaseDirectory → Contents/MonoBundle/).
         Without this file Arc's GeneratedMetadataRegistration returns early, finding no
         project assemblies, so no commands/queries are registered and every API request
         falls through to the SPA fallback returning index.html. -->
    <Target Name="IncludeDepsJsonInBundle"
            AfterTargets="_CreateAppBundle"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <PropertyGroup>
            <_MonoBundleDir>$(OutputPath)$(AssemblyName).app/Contents/MonoBundle/</_MonoBundleDir>
            <_DepsJsonSource>$(OutputPath)$(AssemblyName).deps.json</_DepsJsonSource>
            <_DepsJsonDest>$(_MonoBundleDir)$(AssemblyName).deps.json</_DepsJsonDest>
        </PropertyGroup>
        <Copy SourceFiles="$(_DepsJsonSource)"
              DestinationFiles="$(_DepsJsonDest)"
              Condition="Exists('$(_DepsJsonSource)')" />
        <Message Text="[Maui] Copied deps.json into app bundle (DependencyContext support)" Importance="high"
                 Condition="Exists('$(_DepsJsonSource)')" />
        <Warning Text="[Maui] $(AssemblyName).deps.json not found at $(_DepsJsonSource) — DependencyContext.Default will be null at runtime."
                 Condition="!Exists('$(_DepsJsonSource)')" />
    </Target>

    <!-- Mac Catalyst: strip build-tool artifacts that the Xamarin SDK can't classify.
         ProxyGenerator.Build outputs apphost and runtimeconfig.json for its own use
         as a dotnet tool; they must not be bundled into the Mac Catalyst app bundle. -->
    <Target Name="ExcludeBuildToolArtifactsFromBundle"
            AfterTargets="ComputeResolvedFilesToPublishList"
            BeforeTargets="_CategorizeResolvedFilesToPublish"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'apphost'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(Filename)').EndsWith('.runtimeconfig'))" />
        </ItemGroup>
    </Target>

</Project>
