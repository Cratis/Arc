<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Arc.Samples.VerifiedCallerAcceptance.Specs</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <WarningsAsErrors>$(WarningsAsErrors);CRSPEC0008</WarningsAsErrors>
        <NoWarn>$(NoWarn);SA0001;SA1600;IDE0005;IDE1006;MA0101;RCS1266;xUnit1031</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../VerifiedCallerAcceptance/VerifiedCallerAcceptance.csproj" />
        <Compile Include="../../Source/DotNET/Arc.Core.Specs/Identity/ForwardedIdentityHop/given/certificates.cs" Link="given/certificates.cs" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Vectors/forwarded-identity-v2-vectors.json" Link="forwarded-identity-v2-vectors.json" CopyToOutputDirectory="PreserveNewest" />
        <Using Include="Xunit" />
        <Using Include="Cratis.Specifications" />
    </ItemGroup>
</Project>
