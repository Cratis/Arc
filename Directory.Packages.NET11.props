<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- net11.0 uses the 11.x line of the runtime-aligned Microsoft packages; the base file is the net10.0 pin.
         Microsoft.Extensions.Telemetry, Resilience and TimeProvider.Testing have no 11.x release, so they stay on 10.x. -->
    <ItemGroup>
        <PackageVersion Update="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
        <PackageVersion Update="Microsoft.Extensions.Configuration.FileExtensions" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.Extensions.Logging" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.Extensions.DependencyModel" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="System.Collections.Immutable" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="System.Reflection.MetadataLoadContext" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="System.Text.Json" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="System.Security.Cryptography.Xml" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Update="System.Formats.Asn1" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>
</Project>
